//windows UDP图传
#include <winsock2.h>
#include <ws2tcpip.h>
#include <opencv2/opencv.hpp>
#include <iostream>
#include <vector>

#pragma comment(lib, "ws2_32.lib")

#define PORT 8080
#define MAX_PACKET_SIZE 1024
#define HEADER_SIZE 8
#define MAGIC_NUMBER 0xABCD1234

int main() {
    // 初始化 Winsock
    WSADATA wsaData;
    if (WSAStartup(MAKEWORD(2, 2), &wsaData)) {
        std::cerr << "WSAStartup 初始化失败" << std::endl;
        return -1;
    }

    // 创建 UDP 套接字
    SOCKET sockfd = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
    if (sockfd == INVALID_SOCKET) {
        std::cerr << "Socket 创建失败" << std::endl;
        WSACleanup();
        return -1;
    }

    // 配置本地地址
    sockaddr_in recv_addr;
    memset(&recv_addr, 0, sizeof(recv_addr));
    recv_addr.sin_family = AF_INET;
    recv_addr.sin_port = htons(PORT);
    recv_addr.sin_addr.s_addr = htonl(INADDR_ANY);

    // 绑定端口
    if (bind(sockfd, (SOCKADDR*)&recv_addr, sizeof(recv_addr)) == SOCKET_ERROR) {
        std::cerr << "Socket 绑定失败" << std::endl;
        closesocket(sockfd);
        WSACleanup();
        return -1;
    }

    std::cout << "接收器已启动，等待图像..." << std::endl;

    // 视频写入器
    cv::VideoWriter writer;
    bool writer_initialized = false;

    while (true) {
        // 接收头部
        char header_buf[HEADER_SIZE];
        sockaddr_in sender_addr;
        int sender_len = sizeof(sender_addr);

        int header_received = recvfrom(sockfd, header_buf, HEADER_SIZE, 0,
                                       (SOCKADDR*)&sender_addr, &sender_len);
        if (header_received != HEADER_SIZE) {
            std::cerr << "头部接收失败" << std::endl;
            continue;
        }

        uint32_t* header = reinterpret_cast<uint32_t*>(header_buf);
        uint32_t magic = ntohl(header[0]);
        uint32_t total_size = ntohl(header[1]);

        if (magic != MAGIC_NUMBER) {
            std::cerr << "无效头部标识" << std::endl;
            continue;
        }

        // 接收图像数据
        std::vector<uchar> img_buf(total_size);
        size_t received_total = 0;

        while (received_total < total_size) {
            int recv_size = recvfrom(sockfd,
                                     reinterpret_cast<char*>(img_buf.data() + received_total),
                                     std::min(MAX_PACKET_SIZE, static_cast<int>(total_size - received_total)),
                                     0, (SOCKADDR*)&sender_addr, &sender_len);
            if (recv_size <= 0) {
                std::cerr << "图像数据接收失败" << std::endl;
                break;
            }
            received_total += recv_size;
        }

        // 解码图像
        cv::Mat image = cv::imdecode(img_buf, cv::IMREAD_COLOR);
        if (image.empty()) {
            std::cerr << "图像解码失败" << std::endl;
            continue;
        }

        // 初始化视频写入器
        if (!writer_initialized) {
            writer.open("C:/Users/azw20/Desktop/own_smart_car/own_car/recorded/track_video.avi", cv::VideoWriter::fourcc('M','J','P','G'),
                        25, image.size());
            if (!writer.isOpened()) {
                std::cerr << "无法打开视频写入器" << std::endl;
                break;
            }
            writer_initialized = true;
        }

        // 写入视频
        writer.write(image);

        // 显示图像
        cv::imshow("Received Image", image);
        int key = cv::waitKey(1);

        if (key == 27) break; // 按 ESC 键退出

        // 按下 's' 键保存图像
        if (key == 's' || key == 'S') {
            static int save_count = 0;
            std::string filename = "C:/Users/azw20/Desktop/own_smart_car/own_car/recorded/saved_images/snapshot_" + std::to_string(save_count++) + ".png";
            if (cv::imwrite(filename, image)) {
                std::cout << "图像已保存至: " << filename << std::endl;
            } else {
                std::cerr << "图像保存失败" << std::endl;
            }
        }
    }

    writer.release();
    closesocket(sockfd);
    WSACleanup();
    return 0;
}
